<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Panel Administrador</title>
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>
    <div class="login-container">
        <button class="btn-theme" title="Cambiar tema">🌙</button>
        <div class="login-header">
            <h1>Panel Administrador</h1>
            <p>Ingresa tus credenciales para continuar</p>
        </div>

        <div id="alert" class="alert"></div>

        <form id="loginForm">
            <div class="form-group">
                <label for="email">Correo electrónico</label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    placeholder="admin@ejemplo.com"
                    required
                    autocomplete="email"
                >
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <input 
                    type="password" 
                    id="password" 
                    name="password" 
                    placeholder="••••••••"
                    required
                    autocomplete="current-password"
                >
            </div>

            <button type="submit" class="btn-login btn-primary" id="btnLogin">
                Ingresar
            </button>

            <button type="button" class="btn-acceso-rapido" id="btnAccesoRapido">
                ⚡ Acceso rápido
            </button>
        </form>
    </div>

    <script src="/js/tema.js"></script>
    <script src="/js/login.js"></script>
</body>
</html>