<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Productos - Panel Administrador</title>
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/productos.css">
</head>
<body>
    <div class="header">
        <h1>Panel de Administración - Productos</h1>
        <div class="actions">
            <button class="btn-theme" title="Cambiar tema">🌙</button>
            <button class="btn btn-success" onclick="agregarProducto()">+ Agregar Producto</button>
            <button class="btn btn-secondary" onclick="volver()">Volver</button>
        </div>
    </div>

    <div class="container">
        <div id="alert" class="alert"></div>

        <div class="filters">
            <label>Filtrar por estado:</label>
            <select id="filtroEstado" onchange="cargarProductos()">
                <option value="todos">Todos</option>
                <option value="activo">Activos</option>
                <option value="inactivo">Inactivos</option>
            </select>
        </div>

        <div id="loading" class="loading">
            Cargando productos...
        </div>

        <div id="tableContainer" style="display: none;">
            <table id="productosTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Imagen</th>
                        <th>Título</th>
                        <th>SKU</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="productosBody">
                </tbody>
            </table>
        </div>

        <div id="emptyState" class="empty-state" style="display: none;">
            No hay productos para mostrar
        </div>
    </div>

    <!-- Modal de confirmación -->
    <div id="modalConfirm" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalTitle">Confirmar acción</h2>
            </div>
            <div class="modal-body">
                <p id="modalMessage"></p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="cerrarModal()">Cancelar</button>
                <button class="btn btn-primary" id="btnConfirmar">Confirmar</button>
            </div>
        </div>
    </div>

    <script src="/js/tema.js"></script>
    <script src="/js/productos.js"></script>
</body>
</html>